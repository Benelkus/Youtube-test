#!/usr/bin/env bash
# Usage : ./make_shorts "https://www.youtube.com/watch?v=..."   ou   ./make_shorts ma_video.mp4
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -x "$DIR/.venv/bin/python" ]; then
  echo "Installation manquante : lance d'abord $DIR/install.sh" >&2
  exit 1
fi
PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$DIR/.venv/bin/python" -m shortmaker "$@"
